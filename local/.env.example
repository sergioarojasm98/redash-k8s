# =============================================================================
# Redash Local K8s - Environment Variables
# =============================================================================
# Usado por: deploy.sh → envsubst → 02-secrets.yaml
#
# Genera los secrets con:
#   openssl rand -base64 32
# =============================================================================

# Redash security keys
REDASH_COOKIE_SECRET="CHANGE_ME_cookie_secret"
REDASH_SECRET_KEY="CHANGE_ME_secret_key"

# Local PostgreSQL password
POSTGRES_PASSWORD="redash_local_password"
