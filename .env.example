# =============================================================================
# Redash K8s - Environment Variables
# =============================================================================
# Usado por: deploy.sh (local) y como referencia para GitHub Secrets (CD)
#
# Genera los secrets con:
#   openssl rand -base64 32
# =============================================================================

# Redash Core Secrets
REDASH_COOKIE_SECRET="your_cookie_secret_here"
REDASH_SECRET_KEY="your_secret_key_here"

# Database Configuration (Supabase)
REDASH_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@redash-postgres-pooler:5432/postgres"

# SMTP Configuration (Resend)
REDASH_MAIL_SERVER="smtp.resend.com"
REDASH_MAIL_PORT="587"
REDASH_MAIL_USE_SSL="false"
REDASH_MAIL_USE_TLS="true"
REDASH_MAIL_USERNAME="resend"
REDASH_MAIL_PASSWORD="your_resend_api_key_here"
REDASH_MAIL_DEFAULT_SENDER="Redash <no-reply@yourdomain.com>"

# Cloudflare Tunnel
TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"

# Kubernetes
KUBE_NAMESPACE="redash"

# Rackspace Spot (usado por GitHub Actions CD workflow)
RACKSPACE_ORG_NAME="your_org_name"
RACKSPACE_CLUSTER_ID="your_cluster_id"
RACKSPACE_REFRESH_TOKEN="your_rackspace_refresh_token_here"
